# 1. Use lightweight Python 3.12 image
FROM python:3.12-slim

# 2. Set environment variables
# Prevent Python from writing .pyc files
ENV PYTHONDONTWRITEBYTECODE=1
# Ensure output is flushed directly to terminal (useful for Docker logs)
ENV PYTHONUNBUFFERED=1

# 3. INSTALL SYSTEM DEPENDENCIES & CHROME
# We need wget/gnupg to download Chrome and install it manually
RUN apt-get update && apt-get install -y wget gnupg unzip curl \
    && wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | apt-key add - \
    && sh -c 'echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google-chrome.list' \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

# 4. Set working directory
WORKDIR /app

# 5. Install uv (Fast Python package manager)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# 6. Copy dependency files and install
COPY pyproject.toml uv.lock ./
# Install dependencies from the 'etl' group (Selenium, Typer, etc.)
RUN uv sync --group etl --frozen

# 7. Copy application source code
COPY src/ ./src/

# 8. ENTRYPOINT
# Configures the container to run as the Typer CLI.
# Arguments passed to 'docker run' will be appended here.
ENTRYPOINT ["uv", "run", "python", "-m", "src.main"]
