# ============================================================================
# Imagenes del proyecto — base portable + Chrome solo donde hace falta
# ============================================================================
# Chrome lo usan dos consumidores que no se conocen entre si: el scraping de
# DENUE (`src/etl/utils/browser.py`) y el agente de supervivencia, que lee
# Google Maps y Facebook (`src/agents/survival/sources/navegador.py`). Tenerlo
# en la base obligaba a que migraciones y tests cargaran un navegador amd64
# de ~500 MB que no usan. Por eso vive en una etapa propia, `navegador`, de
# la que salen las dos imagenes que lo necesitan:
#
#   --target tools    migraciones, pytest, scripts. Portable (arm64 y amd64).
#   --target etl      el pipeline: navegador + src/ horneado + CLI del ETL.
#   --target agente   los agentes: navegador + CLI de los agentes, codigo montado.
#
# `agente` NO sale de `etl`: el agente no importa del ETL
# (tests/unit/test_layer_boundaries.py) y su imagen tampoco lo lleva. Lo que
# comparten es el navegador, que es infraestructura, no codigo de una capa.

# ─── base: interprete y dependencias del proyecto ───────────────────────────
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# `--no-dev` y no `--group etl`: ese grupo nunca existio en pyproject.toml, asi
# que el build fallaba con "Group `etl` is not defined". Lo que se queria decir
# es "las dependencias del proyecto, sin las de desarrollo".
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# ─── tools: migraciones, tests y scripts ────────────────────────────────────
# Sin Chrome, asi que construye y corre en cualquier arquitectura. El codigo
# se monta desde compose en vez de copiarse: re-correr los tests tras editar
# no debe costar un rebuild.
FROM base AS tools

RUN uv sync --frozen

# `uv run` como entrypoint deja que compose pase la herramienta como
# argumento: `alembic upgrade head`, `pytest`, `python -m scripts...`.
ENTRYPOINT ["uv", "run"]
CMD ["pytest"]

# ─── navegador: base + Chrome, sin codigo ───────────────────────────────────
# amd64 unicamente, que es lo que corre la workstation; en arm64 habria que
# cambiar a chromium (arquitectura.md §2.3.3).
FROM base AS navegador

RUN apt-get update && apt-get install -y --no-install-recommends \
        wget gnupg ca-certificates \
    && mkdir -p /etc/apt/keyrings \
    && wget -q -O /etc/apt/keyrings/google-chrome.asc \
        https://dl-ssl.google.com/linux/linux_signing_key.pub \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.asc] \
http://dl.google.com/linux/chrome/deb/ stable main" \
        > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

# ─── etl: el pipeline, con el codigo horneado ───────────────────────────────
FROM navegador AS etl

# Todo src/ de una vez: etl, meta y api dependen de src/shared (copiarlos por
# separado dejaba la imagen sin el paquete compartido).
COPY src/ ./src/

ENTRYPOINT ["uv", "run", "python", "-m", "src.etl.main"]

# ─── agente: los agentes LLM, con el navegador y el codigo montado ──────────
# Sin COPY de src/: compose monta src/ (editar el prompt no pide rebuild,
# igual que en `tools`). Solo se reconstruye si cambian dependencias o Chrome.
FROM navegador AS agente

ENTRYPOINT ["uv", "run", "python", "-m", "src.agents.main"]
