# ============================================================================
# Imagen del ETL — base portable + Chrome solo donde hace falta
# ============================================================================
# Chrome lo usan DOS archivos (`utils/browser.py`, `utils/denue_scraping.py`),
# ambos del scraping de DENUE. Tenerlo en la base obligaba a que las
# migraciones y los tests cargaran un navegador amd64 de ~500 MB que no usan,
# y de paso volvia la imagen inconstruible en arm64 --o sea, en la Mac de
# desarrollo. Por eso Chrome vive solo en la etapa que lo necesita:
#
#   --target tools   migraciones, pytest, scripts. Portable (arm64 y amd64).
#   --target etl     el pipeline. Lleva Chrome; amd64.

# ─── base: interprete y dependencias del proyecto ───────────────────────────
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# `uv run` revisa el entorno y lo sincroniza antes de ejecutar. Dentro de un
# contenedor eso es trabajo perdido --el venv ya quedo resuelto en el build--
# y rompe en cuanto el contenedor no corre como root: el venv es de root y el
# proceso no puede escribirlo. Se veia como "Installed 6 packages" en CADA
# invocacion; eran las dependencias de desarrollo que la etapa `etl` no
# instala a proposito y que `uv run` reponia al vuelo.
# El venv en el PATH: `uv` es una herramienta de BUILD y no se usa en
# runtime. Lanzar con `uv run` arrastraba dos problemas que no tenian por
# que existir -- resincronizaba el entorno en cada invocacion ("Installed 6
# packages" cada vez) e inicializaba su cache, que falla en cuanto el
# contenedor no corre como root: el UID del host no tiene entrada en
# /etc/passwd, `HOME` queda en `/` y no hay donde escribirla.
ENV PATH="/app/.venv/bin:$PATH"

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# `--no-dev` y no `--group etl`: ese grupo nunca existio en pyproject.toml, asi
# que el build fallaba con "Group `etl` is not defined". Lo que se queria decir
# es "las dependencias del proyecto, sin las de desarrollo".
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# ─── tools: migraciones, tests y scripts ────────────────────────────────────
# Sin Chrome, asi que construye y corre en cualquier arquitectura. El codigo
# se monta desde compose en vez de copiarse: re-correr los tests tras editar
# no debe costar un rebuild.
FROM base AS tools

RUN uv sync --frozen

# Sin entrypoint: con el venv en el PATH, compose pasa la herramienta tal
# cual --`pytest`, `alembic upgrade head`, `python -m scripts...`-- y se
# ejecuta la del entorno.
CMD ["pytest"]

# ─── etl: el pipeline, con el navegador del scraping ────────────────────────
FROM base AS etl

# amd64 unicamente, que es lo que corre la workstation; en arm64 habria que
# cambiar a chromium (arquitectura.md §2.3.3).
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget gnupg ca-certificates \
    && mkdir -p /etc/apt/keyrings \
    && wget -q -O /etc/apt/keyrings/google-chrome.asc \
        https://dl-ssl.google.com/linux/linux_signing_key.pub \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.asc] \
http://dl.google.com/linux/chrome/deb/ stable main" \
        > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

# Todo src/ de una vez: etl, meta y api dependen de src/shared (copiarlos por
# separado dejaba la imagen sin el paquete compartido).
COPY src/ ./src/

ENTRYPOINT ["python", "-m", "src.etl.main"]
