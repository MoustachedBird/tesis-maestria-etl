# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class

# --- Distribution & Virtual Environments ---
dist/
build/
*.egg-info/
.venv/
venv/
env/

# --- Dependency Management (uv) ---
# It is recommended to commit uv.lock for reproducibility
# If you prefer not to, uncomment the line below:
# uv.lock

# --- IDEs & macOS ---
.DS_Store
.vscode/
.idea/

# --- ENVIRONMENT VARIABLES & SECRETS (CRITICAL) ---
.env
.env.prod
.env.test

# --- DATA LAKE & MODELS (DO NOT COMMIT) ---
data/bronze/*
data/silver/*
data/gold/*

# Exception: Keep empty folder structure
!data/models/.gitkeep

# --- Local Databases & Files ---
*.duckdb
*.db
*.sqlite3
*.csv
*.wal
*.log

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- Testing & Coverage ---
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
*.cover
.hypothesis/
.tox/
.nox/

# --- Type Checking & Linting ---
.mypy_cache/
.pytype/
.dmypy.json
dmypy.json
.ruff_cache/

# --- Logs ---
logs/

# --- Data Archive (backups, one-time files) ---
data/archive/
