# ============================================================================
# ETL Core - Environment Configuration
# ============================================================================
# Copy this file to .env and update the values for your environment

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Database backend: "duckdb" or "postgresql"
DATABASE_BACKEND=duckdb

# DuckDB Configuration (used when DATABASE_BACKEND=duckdb)
SILVER_DUCKDB_PATH=data/silver/denue.duckdb
GOLD_DUCKDB_PATH=data/gold/denue.duckdb
DUCKDB_THREADS=8
DUCKDB_MEMORY_LIMIT=16GB

# Metadata Database (for job execution tracking)
METADATA_DUCKDB_PATH=data/metadata.duckdb

# PostgreSQL Configuration (used when DATABASE_BACKEND=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=denue
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# SQLAlchemy Configuration
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_PRE_PING=true

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API Configuration
API_TITLE=DENUE ETL API
API_VERSION=0.1.0
API_PREFIX=/api/v1

# ----------------------------------------------------------------------------
# CLEE Resolution (Entity Resolution)
# ----------------------------------------------------------------------------
# Number of multiprocessing workers for matching.
# Set to 1 for sequential (debug) mode. Default: 8.
MATCH_WORKERS=8

# Max rows per KB partition. If a reference period's KB exceeds this,
# it is split into sequential partitions to avoid OOM on machines with
# limited RAM. Each partition builds its own BallTree independently.
# Lower = less RAM usage, higher = fewer partitions (faster but more RAM).
# Default: 1,500,000 (~0.5-0.8 GB per partition when materialized).
KB_MAX_ROWS_PER_PARTITION=1500000

# ----------------------------------------------------------------------------
# Testing Configuration
# ----------------------------------------------------------------------------
# Path to production DuckDB database for integration tests
# This is used by pytest to run tests against real data
TEST_DB_PATH=data/denue_warehouse_most_recent.db

# ----------------------------------------------------------------------------
# Project Paths (usually don't need to change these)
# ----------------------------------------------------------------------------
# These are computed automatically but can be overridden if needed
# PROJECT_ROOT=
# DATA_DIR=data
# BRONZE_DIR=data/bronze
# SILVER_DIR=data/silver
# GOLD_DIR=data/gold
# SEEDS_DIR=data/seeds
# LOGS_DIR=logs