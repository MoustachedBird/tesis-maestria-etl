# ============================================================================
# ETL Core - Environment Configuration
# ============================================================================
# Copia este archivo a .env y ajusta los valores para tu maquina.
#
# PREMISA: optimizar tiempo de ejecucion Y uso de RAM, aprovechando la CPU
# con paralelizacion. Las variables de recursos controlan ese balance --
# ajustarlas segun la maquina (ver docs/entorno_linux.md).
#
# MOTOR: PostgreSQL, unico. No hay flag para elegir backend -- Settings,
# el engine de SQLAlchemy y Alembic solo hablan Postgres.
#
# Lo unico que sigue siendo archivo es la ENTRADA: los ZIP de Bronze y los
# seeds versionados. Silver, Gold y los metadatos viven en la base.

# ----------------------------------------------------------------------------
# PostgreSQL -- conexion
# ----------------------------------------------------------------------------
# Una sola base con tres schemas: silver, gold y meta (arquitectura.md
# §2.3). Desde el contenedor del ETL el host es "postgres" (nombre del
# servicio de compose); desde el host de la maquina, "localhost".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mipymes

# Rol DUENO del esquema: lo usan el ETL, el scheduler y Alembic.
POSTGRES_USER=etl_rw
POSTGRES_PASSWORD=your_secure_password_here

# Rol de SOLO LECTURA del API: unicamente SELECT en gold y meta, nunca en
# silver. Es la salvaguarda estructural de arquitectura.md §2.3.1 -- con
# este rol, `establecimientos` sin calificar solo puede ser el de gold, asi
# que no hay forma de confundir los dos granos desde el API.
POSTGRES_RO_USER=api_ro
POSTGRES_RO_PASSWORD=another_secure_password_here

# ----------------------------------------------------------------------------
# PostgreSQL - recursos (docs/entorno_linux.md §2)
# ----------------------------------------------------------------------------
# Derivados de la maquina de corridas reales: 24 nucleos / 48 hilos y
# 125 GiB de RAM. Si se corre en una maquina mas chica hay que bajarlos --
# shared_buffers mas grande que la RAM disponible impide arrancar.

# Cache de paginas de Postgres: ~25% de la RAM total.
PG_SHARED_BUFFERS=32GB

# Estimacion de lo que el kernel cachea ademas de shared_buffers (~72% de
# la RAM). No reserva memoria: solo informa al planeador.
PG_EFFECTIVE_CACHE_SIZE=90GB

# Memoria para CREATE INDEX y VACUUM. Alta a proposito: los indices se
# crean por particion despues del COPY, y es la fase que mas se beneficia.
PG_MAINTENANCE_WORK_MEM=16GB

# Memoria POR NODO DE PLAN y POR CONEXION, no global: 20 conexiones con
# 3 nodos de orden cada una pueden usar 60x este valor. Por eso se queda
# modesto aqui y se sube por sesion (SET work_mem) en las cargas masivas.
PG_WORK_MEM=256MB

# Paralelismo. max_parallel_workers = nucleos FISICOS (24), no hilos:
# los workers de Postgres son CPU-bound y el SMT no ayuda en scans.
PG_MAX_WORKER_PROCESSES=48
PG_MAX_PARALLEL_WORKERS=24
PG_MAX_PARALLEL_PER_GATHER=8
PG_MAX_PARALLEL_MAINTENANCE=8

# Ajustes de NVMe. En disco rotatorio subir random_page_cost a 4 y bajar
# effective_io_concurrency a ~2.
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200

# WAL dimensionado para cargas masivas: un max_wal_size chico dispara
# checkpoints a media carga y el COPY se frena.
PG_WAL_BUFFERS=64MB
PG_MAX_WAL_SIZE=16GB
PG_MIN_WAL_SIZE=2GB

# Locks por transaccion. El default (64) no alcanza con una tabla
# particionada: un plan que toca las 20 particiones mas sus indices pide
# un lock por objeto.
PG_MAX_LOCKS_PER_TRANSACTION=256

# /dev/shm del contenedor de Postgres. Las consultas paralelas usan memoria
# compartida dinamica y el default de Docker son 64 MB, con lo que cualquier
# plan paralelo grande falla con "could not resize shared memory segment".
#
# 4 GB y no 1: un hash join paralelo sobre la tabla de hechos pide ~256 MB
# POR WORKER, y con PG_MAX_PARALLEL_PER_GATHER=8 eso son 2 GB en vuelo.
# Visto con 1 GB sobre 82.9M filas. Es tmpfs, asi que solo consume la RAM
# que de verdad se usa: sobredimensionarlo no cuesta nada.
PG_SHM_SIZE=4gb

# ----------------------------------------------------------------------------
# Limites de contenedor (arquitectura.md §2.3.2)
# ----------------------------------------------------------------------------
# Contencion, no racionamiento: con 48 hilos sobra. El oversubscribe
# (32+16 > 48) es intencional -- el ETL espera mientras Postgres trabaja.
CPUS_POSTGRES=32
MEM_POSTGRES=48g
CPUS_ETL=16
MEM_ETL=32g

# Servicio `tools`: migraciones, tests y scripts de validacion. Mucho mas
# chico que el ETL -- no procesa los 82.9M registros, solo los orquesta.
CPUS_TOOLS=8
MEM_TOOLS=8g

# Servicio `api`: solo responde consultas sobre gold y meta.
CPUS_API=4
MEM_API=4g
API_PORT=8000

# Hilos de Polars en el ETL. Acotado para no competir con los workers de
# Postgres por los mismos nucleos.
POLARS_MAX_THREADS=16

# /dev/shm del contenedor del ETL: Chromium (scraping DENUE) se cae en
# Docker con el default de 64 MB.
ETL_SHM_SIZE=2gb

# Filas por bloque de `COPY ... FROM STDIN` en las escrituras masivas
# (src/shared/db/copy.py). Es la cota de RAM del ingest: el buffer CSV de un
# bloque vive entero en memoria antes de irse al servidor, asi que
# RAM_pico ~ COPY_CHUNK_ROWS x bytes_por_fila (500k x ~400 B = ~200 MiB).
# Bajarlo es la palanca si un ingest se queda sin RAM; subirlo ayuda poco,
# porque el cuello es el parseo del servidor.
COPY_CHUNK_ROWS=500000

# Segundos entre latidos del loader de permanencia
# (src/etl/loaders/permanencia.py). Su `INSERT ... SELECT` sobre 82.9M filas
# es UNA sentencia que corre por horas sin que Python tenga nada que
# reportar, asi que un hilo aparte consulta `pg_stat_activity` y registra la
# fase (`wait_event`) y el derrame a temporales. Sin esto, la unica forma de
# distinguir "trabajando" de "colgado" era abrir psql a mano.
# Subirlo ensucia menos el log; bajarlo da mas resolucion. En 0 se apaga.
PERMANENCIA_LATIDO_SEGUNDOS=60

# Bloques de identidades en que se trocea la permanencia. Cada bloque es su
# propia transaccion y commitea, asi que un fallo cuesta a lo mas 1/N del
# trabajo y la corrida se reanuda donde quedo (sin `--force`).
# Ademas suele ser mas RAPIDO que hacerlo de golpe: el GROUP BY completo
# ordena 10M de grupos con una decena de COUNT(DISTINCT) cada uno y se
# derrama a disco, mientras que los ~300k grupos de un bloque caben en
# work_mem. Subirlo acota mas la perdida por fallo y baja el pico de disco;
# bajarlo reduce el numero de vueltas. Divisor de 256 para que el reparto
# por md5 sea uniforme. En 1 se construye de una sola vez.
PERMANENCIA_BLOQUES=32

# -----------------------------------------------------------------------------
# Gold: la cohorte con CLEE oficial (gold_cohorte_2021.md)
# -----------------------------------------------------------------------------
# Cobertura minima de `clee` para que un corte entre a la ventana oficial.
# Mismo 99.9% que scripts/evaluate_masked_clee.py, para que las dos partes del
# proyecto llamen oficial a lo mismo.
# Medido el 2026-11-08 la cobertura es exactamente 0% o exactamente 100% (11
# cortes al 0%, 9 al 100%), asi que hoy el umbral no decide nada: es la guarda
# para el dia en que INEGI publique un corte a medias. Bajarlo mete cortes
# parciales, donde el <0.1% sin `clee` se queda sin identidad observada.
GOLD_COBERTURA_CLEE_MINIMA=0.999

# MESES sin aparecer en el DENUE a partir de los cuales gold declara que un
# negocio cerro. Es LA REGLA que gold existe para validar: el DENUE no
# reporta cierres, solo deja de listar, asi que `cerrado` es una hipotesis y
# la muestra verificada en linea con agentes es la prueba
# (verificacion_cierre.md).
# En meses y no en cortes porque los cortes no son equidistantes (6, 6, 6,
# 12, 6, 6, 6, 12): "un corte ausente" vale el doble de evidencia para unos
# negocios que para otros. 12 = dos ciclos de la cadencia semestral, que es
# la regla preliminar del protocolo ("dos cortes consecutivos") en tiempo.
# Bajarlo detecta mas cierres con mas falsos positivos; subirlo exige mas
# evidencia a cambio de perder los cierres recientes por censura.
# `meses_sin_aparecer` y `huecos` quedan en la tabla, asi que cambiar esto
# permite recalcular la columna sin reconstruir los 9.58M de filas.
CIERRE_MESES_AUSENTE=12

# Version de las reglas de normalizacion, que queda grabada en cada fila.
# Cambiar una regla cambia los numeros que reporta la tesis, asi que subir
# esto es parte del cambio: sin eso, dos filas construidas con reglas
# distintas son indistinguibles.
GOLD_VERSION_REGLAS=v1

# -----------------------------------------------------------------------------
# Agente de supervivencia (verificacion_cierre.md, crear_agentes.md §9)
# -----------------------------------------------------------------------------
# Ollama corre NATIVO en el host (sin sudo, con el tarball) y usa la GPU; el
# contenedor del agente lo alcanza por host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
# Modelo de pesos abiertos con llamada de herramientas; queda grabado en cada
# veredicto como `modelo/version`. Para 32 GB de VRAM: qwen3:32b (default),
# gpt-oss:20b (mas rapido), mistral-small3.1:24b. `ollama pull <modelo>` antes.
OLLAMA_MODEL=qwen3:32b
OLLAMA_TIMEOUT_SEGUNDOS=600
# Ventana de contexto pedida al servidor (el default de Ollama, 4k, no alcanza).
OLLAMA_CONTEXTO_TOKENS=32768
# Razonar antes de responder (`think`): mejor en casos dificiles, 2-5x tokens.
OLLAMA_PENSAR=false
# Version del prompt/protocolo del agente. Subir al cambiar el prompt.
AGENTE_VERSION=v1
# Buscador: SearXNG del compose por default; con BRAVE_API_KEY se usa Brave.
SEARXNG_URL=http://searxng:8080
BRAVE_API_KEY=
# Presupuesto por negocio: busquedas, paginas leidas y vueltas con el modelo.
AGENTE_MAX_BUSQUEDAS=8
AGENTE_MAX_PAGINAS=6
AGENTE_MAX_VUELTAS=16
AGENTE_MAX_CARACTERES_PAGINA=6000
AGENTE_TIMEOUT_HTTP_SEGUNDOS=20
# Muestra: negocios por estrato (4 estratos) y semilla de setseed() en [-1, 1].
MUESTRA_CUOTA_POR_ESTRATO=100
MUESTRA_SEMILLA=0.42
# Secreto de SearXNG (cualquier cadena larga; solo firma cookies internas).
SEARXNG_SECRET=cambia-esto-por-una-cadena-larga

# SQLAlchemy Configuration
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_PRE_PING=true

# Postgres desechable contra el que corren los tests marcados `postgres`
# (pytest -m postgres). Si se deja vacia, se deriva de POSTGRES_* de arriba
# agregando el sufijo `_test` al nombre de la base, para no escribir jamas
# sobre la base real. Los tests marcados se SALTAN solos cuando no hay
# servidor alcanzable, asi que dejarla vacia es valido.
TEST_POSTGRES_URL=

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API Configuration
API_TITLE=DENUE ETL API
API_VERSION=0.1.0
API_PREFIX=/api/v1

# ----------------------------------------------------------------------------
# CLEE Resolution (Entity Resolution)
# ----------------------------------------------------------------------------
# Workers de multiprocessing para el loop de matching (fork + copy-on-write).
# Regla practica: cores fisicos - 3 (deja 1 para el padre/logging y 2 al OS).
# Ejemplo: MATCH_WORKERS=1 desactiva el paralelismo (modo debug secuencial).
MATCH_WORKERS=6

# Maximo de filas por particion de la KB de referencia. Si la KB de un
# periodo excede esto, se divide en particiones secuenciales.
# Es el knob principal de RAM del matching: cada worker puede terminar
# tocando (y por COW copiando) las paginas de la particion compartida.
# Menor = menos RAM pico, mayor = menos particiones (mas rapido).
# Ejemplo: con 8GB de presupuesto, 1000000 (~0.5GB materializada) es seguro.
KB_MAX_ROWS_PER_PARTITION=1000000

# Minimo de filas pendientes para activar multiprocessing en el matching.
# Por debajo de esto el overhead de fork no compensa y se corre secuencial.
MATCH_PARALLEL_THRESHOLD=50000

# Filas del target por lote en el blocking H3 (cota de RAM de ese metodo).
# El blocking materializa los pares candidatos antes de filtrar por
# distancia: cada fila se cruza con las ~37 celdas de su grid_disk y cada
# celda con sus referencias. Sobre 2.7M de target son cientos de millones
# de pares, y el `sort` posterior agota la memoria del contenedor -- el OOM
# killer mato una corrida ahi. Trocear NO cambia el resultado: la
# agregacion es por fila del target y cada fila cae completa en un lote.
# Bajarlo si vuelve a morir por memoria; subirlo solo si sobra RAM.
H3_TARGET_CHUNK_ROWS=250000

# --- Calibracion del matching CLEE ---
# Umbrales de la cascada de entity resolution. Defaults en
# src/etl/utils/clee_resolution_config.py (cada uno con su docstring).
# Regla general: mas bajo = mas matches (mas falsos positivos);
# mas alto = menos matches (mas falsos negativos).

# Radio maximo (metros) para buscar candidatos en la KB de referencia.
# Aplica a AMBOS metodos de propagacion (radio/BallTree y blocking H3);
# 500m cubre mudanzas dentro del mismo barrio/colonia.
# OJO: si lo subes por encima de ~522m (H3_GRID_DISK_K=3 anillos x ~174m),
# el blocking H3 deja de cubrir el radio y el import falla con instrucciones
# (hay que subir H3_GRID_DISK_K en clee_resolution_config.py y re-verificar
# la paridad H3 vs BallTree).
SPATIAL_RADIUS_M=500

# Gate obligatorio: similitud fuzzy minima en la actividad SCIAN. Un
# candidato que no lo supera se descarta sin evaluar nada mas.
ACTIVITY_GATE_THRESH=60

# Match directo por nombre comercial (token_sort_ratio sobre nom_estab).
BUSINESS_NAME_MATCH_THRESH=75

# Match directo por razon social. Mas estricto que el nombre comercial
# (razones sociales se repiten entre negocios de un mismo dueno).
LEGAL_NAME_MATCH_THRESH=80

# Match combinado: cuantas senales debiles (nombre parcial, telefono,
# email, web, codigo postal) deben coincidir para declarar match.
MIN_COMBINED_SIGNALS=2

# Umbral de nombre comercial para contar como senal "parcial" del match
# combinado (mas bajo que BUSINESS_NAME_MATCH_THRESH: aqui no basta sola).
PARTIAL_NAME_THRESH=60

# NOTA: las resoluciones H3 (H3_BLOCKING_RES=9, H3_PARTITION_RES=5) y
# H3_GRID_DISK_K NO son variables de entorno a proposito: estan
# materializadas en las columnas h3_cell_9/h3_cell_5 de Silver; cambiarlas
# exige migracion + re-backfill (ver docstrings en clee_resolution_config.py).

# ----------------------------------------------------------------------------
# Downloads (prefijo DOWNLOAD_, ver src/etl/core/download_config.py)
# ----------------------------------------------------------------------------
# Las descargas son secuenciales por decision: el cuello es el servidor de
# INEGI, que castiga la concurrencia, asi que paralelizar seria mas lento.

# Reintentos por descarga fallida (con backoff exponencial)
DOWNLOAD_MAX_RETRIES=3

# Timeout por request HTTP en segundos. OJO: requests lo aplica como read
# timeout, y ese reloj se REINICIA con cada chunk que llega. Por si solo no
# acota la duracion de una descarga.
DOWNLOAD_TIMEOUT_SECONDS=300

# Tope TOTAL de una descarga, de la primera a la ultima byte. Es el unico que
# acota cuanto puede durar: un servidor que gotea unos bytes cada pocos
# segundos mantiene vivo el read timeout indefinidamente. Al dispararse
# levanta Timeout, que es retryable: se reintenta con backoff y, si no cede,
# queda FAILED en metadata y lo recoge la siguiente corrida.
# Dimensionado: el ZIP mas grande de DENUE (~60 MB) baja en ~36 s a 12-17
# Mbps, asi que 900 s exigen ~0.53 Mbps sostenidos -- 20x de holgura. Subirlo
# solo si alguna fuente publica archivos mucho mas grandes.
DOWNLOAD_MAX_DOWNLOAD_SECONDS=900

# ----------------------------------------------------------------------------
# DENUE scraping (ver src/etl/utils/denue_scraping.py)
# ----------------------------------------------------------------------------
# Tope de espera a que la tabla de descargas de INEGI termine de poblarse por
# AJAX. La espera es por contenido, no por presencia del elemento: la tabla
# aparece casi de inmediato con filas placeholder de 2016 y el catalogo
# completo entra despues, asi que esperar al elemento no garantiza nada.
DENUE_SCRAPE_TIMEOUT_SECONDS=120

# Minimo de filas con enlace .zip para dar el scrape por completo. El catalogo
# de INEGI trae ~484; por debajo de esto se levanta error (run FAILED en
# meta.job_runs) en lugar de interpretarlo como "no hay archivos nuevos".
# Subirlo solo si INEGI publica mas archivos; bajarlo si publica menos.
DENUE_SCRAPE_MIN_LINKS=100

# ----------------------------------------------------------------------------
# SESNSP (incidencia delictiva municipal, ver src/etl/extractors/sesnsp.py)
# ----------------------------------------------------------------------------
# API CKAN de datos.gob.mx que describe el dataset. El extractor la consulta
# para descubrir la URL del CSV del corte vigente (el nombre del archivo
# cambia con cada corte mensual: IDM_NM_dic25.csv -> IDM_NM_jun26.csv).
SESNSP_CKAN_PACKAGE_URL=https://www.datos.gob.mx/api/3/action/package_show?id=incidencia_delictiva

# Nombre del recurso CKAN a descargar dentro del paquete
SESNSP_RESOURCE_NAME=Incidencia delictiva municipal

# Override manual: si se define, se salta el descubrimiento CKAN y se
# descarga directamente esta URL (dejar vacio para el flujo normal)
# SESNSP_DOWNLOAD_URL=

# ----------------------------------------------------------------------------
# Project Paths (usually don't need to change these)
# ----------------------------------------------------------------------------
# These are computed automatically but can be overridden if needed
# PROJECT_ROOT=
# DATA_DIR=data
# BRONZE_DIR=data/bronze
# SEEDS_DIR=data/seeds

