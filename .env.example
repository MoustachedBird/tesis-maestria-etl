# ============================================================================
# ETL Core - Environment Configuration
# ============================================================================
# Copy this file to .env and update the values for your environment.
#
# PREMISA (ver todo.md): optimizar tiempo de ejecucion Y uso de RAM,
# aprovechando la CPU con paralelizacion. Las variables de recursos de esta
# seccion controlan ese balance -- ajustarlas segun la maquina.

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Database backend: "duckdb" (dev/analytics) o "postgresql" (produccion)
DATABASE_BACKEND=duckdb

# DuckDB Configuration (used when DATABASE_BACKEND=duckdb)
SILVER_DUCKDB_PATH=data/silver/denue.duckdb
GOLD_DUCKDB_PATH=data/gold/denue.duckdb

# Threads internos de DuckDB (UPDATEs, scans, joins). DuckDB paraleliza
# cada query entre estos threads. Ejemplo: en una M4 Pro de 12 cores,
# 8 deja margen para el resto del sistema.
DUCKDB_THREADS=8

# Presupuesto de RAM de DuckDB. Sin esto DuckDB usa ~80% de la RAM del
# sistema. Se aplica via utils/warehouse.py:connect_configured() en todas
# las etapas (normalize-dates, h3-cells, clee-resolution).
# Ejemplo: "8GB" en una maquina de 24-48GB deja RAM para el matching CLEE.
DUCKDB_MEMORY_LIMIT=8GB

# Metadata Database (for job execution tracking)
METADATA_DUCKDB_PATH=data/metadata.duckdb

# PostgreSQL Configuration (used when DATABASE_BACKEND=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=denue
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# SQLAlchemy Configuration
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_PRE_PING=true

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API Configuration
API_TITLE=DENUE ETL API
API_VERSION=0.1.0
API_PREFIX=/api/v1

# ----------------------------------------------------------------------------
# CLEE Resolution (Entity Resolution)
# ----------------------------------------------------------------------------
# Workers de multiprocessing para el loop de matching (fork + copy-on-write).
# Regla practica: cores fisicos - 3 (deja 1 para el padre/logging y 2 al OS).
# Ejemplo: MATCH_WORKERS=1 desactiva el paralelismo (modo debug secuencial).
MATCH_WORKERS=6

# Maximo de filas por particion de la KB de referencia. Si la KB de un
# periodo excede esto, se divide en particiones secuenciales.
# Es el knob principal de RAM del matching: cada worker puede terminar
# tocando (y por COW copiando) las paginas de la particion compartida.
# Menor = menos RAM pico, mayor = menos particiones (mas rapido).
# Ejemplo: con 8GB de presupuesto, 1000000 (~0.5GB materializada) es seguro.
KB_MAX_ROWS_PER_PARTITION=1000000

# ----------------------------------------------------------------------------
# Downloads (prefijo DOWNLOAD_, ver src_etl/core/download_config.py)
# ----------------------------------------------------------------------------
# Descargas concurrentes desde INEGI. Network-bound: subirlo no acelera
# proporcionalmente y castiga al servidor de INEGI.
# Ejemplo: DOWNLOAD_MAX_PARALLEL_DOWNLOADS=1 para depurar una descarga.
DOWNLOAD_MAX_PARALLEL_DOWNLOADS=3

# Reintentos por descarga fallida (con backoff exponencial)
DOWNLOAD_MAX_RETRIES=3

# Timeout por request HTTP en segundos
DOWNLOAD_TIMEOUT_SECONDS=300

# ----------------------------------------------------------------------------
# Testing Configuration
# ----------------------------------------------------------------------------
# Path to production DuckDB database for integration tests
TEST_DB_PATH=data/denue_warehouse_most_recent.db

# ----------------------------------------------------------------------------
# Project Paths (usually don't need to change these)
# ----------------------------------------------------------------------------
# These are computed automatically but can be overridden if needed
# PROJECT_ROOT=
# DATA_DIR=data
# BRONZE_DIR=data/bronze
# SILVER_DIR=data/silver
# GOLD_DIR=data/gold
# SEEDS_DIR=data/seeds
# LOGS_DIR=logs
