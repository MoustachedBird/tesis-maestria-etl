[run]
source =
    src/db
    src/metadata
    src/transformers
    src/extractors
    src/core
omit =
    */tests/*
    */migrations/*
    */alembic/*
    */__pycache__/*
    */.venv/*
    */conftest.py
    src/transformers/_legacy/*

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = htmlcov
